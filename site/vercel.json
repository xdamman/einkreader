{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/.well-known/nostr.json",
      "destination": "/api/nostr-json"
    },
    {
      "source": "/:name([a-z0-9_]{5,20})",
      "destination": "/api/profile-page?name=:name"
    },
    {
      "source": "/:name([a-z0-9_]{5,20})/feed.xml",
      "destination": "/api/profile-feed?name=:name"
    },
    {
      "source": "/:name([a-z0-9_]{5,20})/:year(\\d{4})",
      "destination": "/api/profile-page?name=:name&year=:year"
    },
    {
      "source": "/:name([a-z0-9_]{5,20})/:year(\\d{4})/:month(\\d{1,2})",
      "destination": "/api/profile-page?name=:name&year=:year&month=:month"
    },
    {
      "source": "/:name([a-z0-9_]{5,20})/s/:sid([0-9a-f]{6,64})",
      "destination": "/api/profile-page?name=:name&sid=:sid"
    },
    {
      "source": "/:name([a-z0-9_]{5,20})/q/:qid([0-9a-f]{8,64})",
      "destination": "/api/profile-page?name=:name&qid=:qid"
    }
  ],
  "redirects": [
    {
      "source": "/branding",
      "destination": "/brand",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 * * * *"
    }
  ]
}
